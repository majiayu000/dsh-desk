{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desk",
  "version": "0.1.0-alpha.8",
  "identifier": "ai.deepseek.harness.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/runtime/": "runtime/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBN0MxODExMzIyRkI5NEIKUldSTHVTOHlFUmg4V2dZUFVRODhHaFB0ZEVpR09SaWEwbWxaVEpTcXZHY05xaElMblhLSXV1WDEK",
      "endpoints": [
        "https://raw.githubusercontent.com/majiayu000/dsh-desk/update-channel-alpha/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
