{
  "name": "dsh-desk",
  "private": true,
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/majiayu000/dsh-desk.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check": "pnpm build && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:harness-contract": "node scripts/test-harness-contract.mjs",
    "test:packaged-runtime": "node scripts/test-harness-contract.mjs --runtime-root resources/runtime",
    "test:plugin-parity": "node scripts/test-plugin-parity.mjs",
    "test:plugin-template": "node scripts/test-plugin-template.mjs",
    "test:cross-device": "node --experimental-strip-types --test tests/cross-device-protocol.test.ts tests/relay.test.mjs",
    "test:updater-contract": "node scripts/test-updater-contract.mjs",
    "relay:dev": "node relay/server.mjs",
    "companion:demo": "node --experimental-strip-types scripts/cross-device-demo.ts",
    "create:plugin": "node scripts/create-plugin.mjs",
    "check:upstream": "node scripts/check-upstream-version.mjs",
    "check:release-env": "node scripts/check-release-env.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "release:macos": "pnpm check:release-env macos && pnpm prepare:runtime && tauri build --bundles dmg && pnpm release:checksums",
    "release:macos:preview": "pnpm prepare:runtime && tauri build --bundles app && DSH_ALLOW_ADHOC=1 node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
